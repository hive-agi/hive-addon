{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.5"}

        ;; hive-dsl — Result monad, rescue/guard DSL, error taxonomy.
        ;; Maven coord (on Clojars) so hive-addon's published pom is self-contained.
        io.github.hive-agi/hive-dsl {:mvn/version "0.5.21"}

        ;; malli — schema layer for the IAddon contract (self-contained; no hive-spi).
        ;; The addon bounded context owns its own schemas (DDD). House pin: 0.20.1.
        metosin/malli {:mvn/version "0.20.1"}}

 ;; hive-hot is deliberately NOT in :deps. hive-addon.hot resolves it through the
 ;; var at call time and degrades to :hot/available? false when it is absent, so
 ;; the published lib stays a three-dep leaf and consumers that want file-watching
 ;; add hive-hot themselves. It appears below only so dev + the suite can exercise
 ;; the wired path alongside the graceful-degradation one.
 :aliases
 {:dev  {:extra-paths ["dev" "test"]
         :extra-deps  {io.github.hive-agi/hive-hot
                       {:git/tag "v0.1.9" :git/sha "18bee5f"}}}

  :test {:extra-paths ["test"]
         :extra-deps  {io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                       ;; test.check — backs the malli.generator generative leg
                       ;; of hive-addon.schema-test (also pulled transitively by
                       ;; malli, pinned here for reproducibility).
                       org.clojure/test.check {:mvn/version "1.1.3"}
                       io.github.hive-agi/hive-hot
                       {:git/tag "v0.1.9" :git/sha "18bee5f"}
                       ;; hive-test supplies the trifecta (golden + property +
                       ;; mutation); hive-schemas synthesizes those facets from
                       ;; the malli schemas in hive-addon.hot.schema. Test-only:
                       ;; the published lib stays a three-dep leaf.
                       io.github.hive-agi/hive-test {:mvn/version "0.4.0"}
                       io.github.hive-agi/hive-schemas {:mvn/version "0.1.29"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}

  ;; Build + Clojars deploy: clojure -T:build jar | clojure -T:build deploy
  :build {:deps {io.github.hive-agi/hive-build {:mvn/version "0.1.10"}}
          :ns-default hive-build.api}}}
